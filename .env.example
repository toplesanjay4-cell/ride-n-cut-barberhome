# Public Supabase values used by the customer and admin browser clients.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only: required for owner-managed staff account creation.
# Never prefix this key with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY

# Optional: required only when booking email notifications are enabled.
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
